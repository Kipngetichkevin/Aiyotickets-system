APP_NAME="Aiyo Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First admin, created by `php artisan db:seed` (leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# M-Pesa (Daraja). Sandbox works with Safaricom's test shortcode; production needs all of these.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BUSINESS_SHORTCODE=
# paybill, or till for Buy Goods (then MPESA_PARTY_B = the Till number, shortcode = its store number)
MPESA_TRANSACTION_TYPE=paybill
MPESA_PARTY_B=
# Public HTTPS URL Safaricom posts results to; defaults to APP_URL/mpesa/callback
MPESA_CALLBACK_URL=

# Errors and failed backups are emailed here in production (comma-separated; defaults to ADMIN_EMAIL)
ALERT_EMAIL=
# Backups: keep a copy off this server, e.g. local,s3 (fill in AWS_* above). Needs mysqldump installed.
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=

# Going live: run `php artisan aiyo:check` on the server. It checks everything below.
# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning, APP_URL=https://<domain>
# Mail must really send (verification links, tickets, organiser decisions): set MAIL_MAILER=smtp etc.
# Cron, every minute: * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#   (runs mpesa:reconcile, instalments:process and the queue worker)
APP_TIMEZONE=Africa/Nairobi
# Set when behind a load balancer / Cloudflare ("*" or comma-separated proxy IPs/CIDRs)
TRUSTED_PROXIES=
# true in production (cookies only sent over HTTPS)
SESSION_SECURE_COOKIE=false

# Platform commission (percent), when sales become withdrawable, and smallest payout (KES)
PLATFORM_FEE_PERCENT=5
PAYOUT_AFTER_END=true
PAYOUT_MINIMUM=100

# Ticket SMS via Africa's Talking (leave empty to disable; AT_USERNAME=sandbox for testing)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Ticket messages via WhatsApp Cloud API (leave empty to disable)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=ticket_ready
WHATSAPP_TEMPLATE_LANG=en

# Only sell tickets inside their sales window. Check first: php artisan tickets:sale-dates
ENFORCE_SALE_DATES=false
